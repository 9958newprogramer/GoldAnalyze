        "title": "IncidentInputProfile",
        "type": "object"
      },
      "IncidentReviewResult": {
        "additionalProperties": false,
        "properties": {
          "action_items": {
            "items": {
              "$ref": "#/components/schemas/IncidentActionItem"
            },
            "maxItems": 8,
            "minItems": 1,
            "title": "Action Items",
            "type": "array"
          },
          "findings": {
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "minItems": 1,
            "title": "Findings",
            "type": "array"
          },
          "input_profile": {
            "$ref": "#/components/schemas/IncidentInputProfile"
