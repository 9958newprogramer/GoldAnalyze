          "row_count": {
            "title": "Row Count",
            "type": "integer"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "start_at": {
            "format": "date-time",
            "title": "Start At",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "synthetic": {
            "title": "Synthetic",
            "type": "boolean"
          },
          "timeframe": {
            "title": "Timeframe",
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "source",
          "synthetic",
          "symbol",
          "timeframe",
          "row_count",
          "start_at",
          "end_at"
        ],
        "title": "DataProfile",
        "type": "object"
      },
      "EquityPoint": {
        "properties": {
          "at": {
            "format": "date-time",
            "title": "At",
            "type": "string"
          },
          "equity": {
            "title": "Equity",
            "type": "number"
          }
        },
        "required": [
          "at",
          "equity"
        ],
        "title": "EquityPoint",
        "type": "object"
      },
      "ExecutionPlan": {
        "additionalProperties": false,
        "description": "Validated plan plus an observable deterministic-execution outcome.",
        "properties": {
          "completed_steps": {
            "items": {
              "type": "string"
            },
            "title": "Completed Steps",
            "type": "array"
          },
          "failed_step": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failed Step"
          },
          "max_tool_calls": {
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Max Tool Calls",
            "type": "integer"
          },
          "paused_step": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paused Step"
          },
          "plan_id": {
            "pattern": "^[a-f0-9]{12}$",
            "title": "Plan Id",
            "type": "string"
          },
          "planned_tool_calls": {
            "maximum": 50.0,
            "minimum": 0.0,
            "title": "Planned Tool Calls",
            "type": "integer"
          },
          "planner": {
            "title": "Planner",
            "type": "string"
          },
          "rejected_step": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rejected Step"
          },
          "skill": {
            "title": "Skill",
            "type": "string"
          },
          "skill_version": {
            "title": "Skill Version",
            "type": "string"
          },
          "skipped_steps": {
            "items": {
              "type": "string"
            },
            "title": "Skipped Steps",
            "type": "array"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/PlanStep"
            },
            "maxItems": 32,
            "minItems": 1,
            "title": "Steps",
            "type": "array"
          },
          "validated": {
            "default": false,
            "title": "Validated",
            "type": "boolean"
          }
        },
        "required": [
          "plan_id",
          "skill",
          "skill_version",
          "planner",
          "steps",
          "max_tool_calls",
          "planned_tool_calls"
        ],
        "title": "ExecutionPlan",
        "type": "object"
      },
      "ExternalResearchResult": {
