{
  "components": {
    "schemas": {
      "AgentEvent": {
        "properties": {
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "duration_ms": {
            "title": "Duration Ms",
            "type": "number"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "sequence": {
            "title": "Sequence",
            "type": "integer"
          },
          "stage": {
            "title": "Stage",
            "type": "string"
          },
          "status": {
            "enum": [
              "completed",
              "warning",
              "failed",
              "waiting_approval"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "sequence",
          "stage",
          "status",
          "message",
          "duration_ms"
        ],
        "title": "AgentEvent",
        "type": "object"
      },
      "AgentExecuteRequest": {
        "additionalProperties": false,
        "description": "Synchronous internal request from Java to the Python Agent Service.",
        "properties": {
          "cache_policy": {
            "default": "use",
            "enum": [
              "use",
              "refresh",
              "bypass"
            ],
            "title": "Cache Policy",
            "type": "string"
          },
          "deadline_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline At"
          },
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 16,
            "title": "Idempotency Key",
            "type": "string"
          },
          "job_id": {
            "maxLength": 128,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Job Id",
            "type": "string"
          },
          "question": {
            "maxLength": 1000,
            "minLength": 4,
            "title": "Question",
            "type": "string"
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Request Id",
            "type": "string"
          },
          "requested_at": {
            "format": "date-time",
            "title": "Requested At",
            "type": "string"
          },
          "run_id": {
            "maxLength": 128,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Run Id",
            "type": "string"
          },
          "schema_version": {
            "const": "agent-execute-request-v1",
            "default": "agent-execute-request-v1",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "job_id",
          "run_id",
          "idempotency_key",
          "question"
        ],
        "title": "AgentExecuteRequest",
        "type": "object"
      },
      "AgentExecuteResponse": {
        "additionalProperties": false,
        "properties": {
          "artifact": {
            "$ref": "#/components/schemas/AgentResultArtifact"
          },
          "duration_ms": {
            "minimum": 0.0,
            "title": "Duration Ms",
            "type": "number"
          },
          "execution_id": {
            "maxLength": 128,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Execution Id",
            "type": "string"
          },
          "job_id": {
            "maxLength": 128,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Job Id",
            "type": "string"
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Request Id",
            "type": "string"
          },
          "result_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Result Digest",
            "type": "string"
          },
          "run_id": {
            "maxLength": 128,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Run Id",
            "type": "string"
          },
          "schema_version": {
            "const": "agent-execute-result-v1",
            "default": "agent-execute-result-v1",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "job_id",
          "run_id",
          "execution_id",
          "artifact",
          "result_digest",
          "duration_ms"
        ],
        "title": "AgentExecuteResponse",
        "type": "object"
      },
      "AgentResultArtifact": {
        "additionalProperties": false,
        "description": "Control-plane projection that deliberately omits the original question.",
        "properties": {
          "approval": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ApprovalRequest"
              },
              {
                "type": "null"
              }
            ]
          },
          "cache": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CacheInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "data_profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DataProfile"
              },
              {
                "type": "null"
              }
            ]
          },
          "equity_curve": {
            "items": {
              "$ref": "#/components/schemas/EquityPoint"
            },
            "maxItems": 321,
            "title": "Equity Curve",
            "type": "array"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/AgentEvent"
            },
            "maxItems": 64,
            "title": "Events",
            "type": "array"
          },
          "incident_result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IncidentReviewResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "incident_spec": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IncidentSpec"
              },
              {
                "type": "null"
              }
            ]
          },
          "interpreter": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Interpreter",
            "type": "string"
          },
          "market_query": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MarketQuerySpec"
              },
              {
                "type": "null"
              }
            ]
          },
          "market_result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MarketQueryResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "metrics": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BacktestMetrics"
              },
              {
                "type": "null"
              }
            ]
          },
          "plan": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExecutionPlan"
              },
              {
                "type": "null"
              }
            ]
          },
          "research_result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExternalResearchResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "research_spec": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExternalResearchSpec"
              },
              {
                "type": "null"
              }
            ]
          },
          "route": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IntentDecision"
              },
              {
                "type": "null"
              }
            ]
          },
          "skill": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Skill",
            "type": "string"
          },
          "status": {
            "enum": [
              "completed",
              "failed",
              "rejected",
              "pending_approval"
            ],
            "title": "Status",
            "type": "string"
          },
          "strategy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StrategySpec"
              },
              {
                "type": "null"
              }
            ]
          },
          "summary": {
            "maxLength": 4000,
            "title": "Summary",
            "type": "string"
          },
          "tool_audit": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "maxItems": 128,
            "title": "Tool Audit",
            "type": "array"
          },
          "trades": {
            "items": {
              "$ref": "#/components/schemas/Trade"
            },
            "maxItems": 10000,
            "title": "Trades",
            "type": "array"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "maxItems": 32,
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "status",
          "skill",
          "interpreter",
          "summary"
        ],
        "title": "AgentResultArtifact",
        "type": "object"
      },
      "ApprovalRequest": {
        "additionalProperties": false,
        "description": "Public, token-free representation of one human approval decision.",
        "properties": {
          "approval_id": {
            "pattern": "^[a-f0-9]{16}$",
            "title": "Approval Id",
            "type": "string"
          },
          "arguments_digest": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Arguments Digest",
            "type": "string"
          },
          "consumed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Consumed At"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "decided_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided At"
          },
          "decided_by": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided By"
          },
          "effect": {
            "enum": [
              "read",
              "external",
              "write",
              "privileged"
            ],
            "title": "Effect",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "plan_id": {
            "pattern": "^[a-f0-9]{12}$",
            "title": "Plan Id",
            "type": "string"
          },
          "reason": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Risk",
            "type": "string"
          },
          "run_id": {
            "pattern": "^[a-f0-9]{12}$",
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "approved",
              "denied",
              "expired",
              "consumed"
            ],
            "title": "Status",
            "type": "string"
          },
          "step_id": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "title": "Step Id",
            "type": "string"
          },
          "tool_name": {
            "maxLength": 128,
            "minLength": 2,
            "title": "Tool Name",
            "type": "string"
          }
        },
        "required": [
          "approval_id",
          "run_id",
          "plan_id",
          "step_id",
          "tool_name",
          "arguments_digest",
          "effect",
          "risk",
          "status",
          "reason",
          "created_at",
          "expires_at"
        ],
        "title": "ApprovalRequest",
        "type": "object"
      },
      "BacktestMetrics": {
        "properties": {
          "final_equity": {
            "title": "Final Equity",
            "type": "number"
          },
          "max_drawdown_pct": {
            "title": "Max Drawdown Pct",
            "type": "number"
          },
          "sharpe_ratio": {
            "title": "Sharpe Ratio",
            "type": "number"
          },
          "total_return_pct": {
            "title": "Total Return Pct",
            "type": "number"
          },
          "trade_count": {
            "title": "Trade Count",
            "type": "integer"
          },
          "win_rate_pct": {
            "title": "Win Rate Pct",
            "type": "number"
          }
        },
        "required": [
          "total_return_pct",
          "max_drawdown_pct",
          "sharpe_ratio",
          "trade_count",
          "win_rate_pct",
          "final_equity"
        ],
        "title": "BacktestMetrics",
        "type": "object"
      },
      "CacheInfo": {
        "description": "Observable provenance for request-local and persistent artifact reuse.",
        "properties": {
          "data_version": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data Version"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "fingerprint": {
            "anyOf": [
              {
                "pattern": "^[a-f0-9]{16}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fingerprint"
          },
          "reason": {
            "default": "",
            "maxLength": 160,
            "title": "Reason",
            "type": "string"
          },
          "saved_latency_ms": {
            "default": 0,
            "minimum": 0.0,
            "title": "Saved Latency Ms",
            "type": "number"
          },
          "saved_tool_calls": {
            "default": 0,
            "minimum": 0.0,
            "title": "Saved Tool Calls",
            "type": "integer"
          },
          "similarity_score": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Similarity Score"
          },
          "source_run_id": {
            "anyOf": [
              {
                "pattern": "^[a-f0-9]{12}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Run Id"
          },
          "status": {
            "enum": [
              "miss",
              "exact_hit",
              "semantic_candidate",
              "refresh",
              "bypass"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "CacheInfo",
        "type": "object"
      },
      "DataProfile": {
        "properties": {
          "duplicate_timestamps": {
            "default": 0,
            "title": "Duplicate Timestamps",
            "type": "integer"
          },
          "end_at": {
            "format": "date-time",
            "title": "End At",
