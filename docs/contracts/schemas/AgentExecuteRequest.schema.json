{
  "additionalProperties": false,
  "description": "Synchronous internal request from Java to the Python Agent Service.",
  "properties": {
    "cache_policy": {
      "default": "use",
      "enum": [
        "use",
        "refresh",
        "bypass"
      ],
      "title": "Cache Policy",
      "type": "string"
    },
    "deadline_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deadline At"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 16,
      "title": "Idempotency Key",
      "type": "string"
    },
    "job_id": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Job Id",
      "type": "string"
    },
    "question": {
      "maxLength": 1000,
      "minLength": 4,
      "title": "Question",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Request Id",
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "agent-execute-request-v1",
      "default": "agent-execute-request-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "job_id",
    "run_id",
    "idempotency_key",
    "question"
  ],
  "title": "AgentExecuteRequest",
  "type": "object"
}
