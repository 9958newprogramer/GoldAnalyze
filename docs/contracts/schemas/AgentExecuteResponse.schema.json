{
  "$defs": {
    "AgentEvent": {
      "properties": {
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "number"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "warning",
            "failed",
            "waiting_approval"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "stage",
        "status",
        "message",
        "duration_ms"
      ],
      "title": "AgentEvent",
      "type": "object"
    },
    "AgentResultArtifact": {
      "additionalProperties": false,
      "description": "Control-plane projection that deliberately omits the original question.",
      "properties": {
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cache": {
          "anyOf": [
            {
              "$ref": "#/$defs/CacheInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "data_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "equity_curve": {
          "items": {
            "$ref": "#/$defs/EquityPoint"
          },
          "maxItems": 321,
          "title": "Equity Curve",
          "type": "array"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/AgentEvent"
          },
          "maxItems": 64,
          "title": "Events",
          "type": "array"
        },
        "incident_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/IncidentReviewResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "incident_spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/IncidentSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "interpreter": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Interpreter",
          "type": "string"
        },
        "market_query": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarketQuerySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "market_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarketQueryResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/BacktestMetrics"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "research_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExternalResearchResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "research_spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExternalResearchSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntentDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "skill": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Skill",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "rejected",
            "pending_approval"
          ],
          "title": "Status",
          "type": "string"
        },
        "strategy": {
          "anyOf": [
            {
              "$ref": "#/$defs/StrategySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "summary": {
          "maxLength": 4000,
          "title": "Summary",
          "type": "string"
        },
        "tool_audit": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 128,
          "title": "Tool Audit",
          "type": "array"
        },
        "trades": {
          "items": {
            "$ref": "#/$defs/Trade"
          },
          "maxItems": 10000,
          "title": "Trades",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "status",
        "skill",
        "interpreter",
        "summary"
      ],
      "title": "AgentResultArtifact",
      "type": "object"
    },
    "ApprovalRequest": {
      "additionalProperties": false,
      "description": "Public, token-free representation of one human approval decision.",
      "properties": {
        "approval_id": {
          "pattern": "^[a-f0-9]{16}$",
          "title": "Approval Id",
          "type": "string"
        },
        "arguments_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Arguments Digest",
          "type": "string"
        },
        "consumed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consumed At"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "decided_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decided At"
        },
        "decided_by": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decided By"
        },
        "effect": {
          "enum": [
            "read",
            "external",
            "write",
            "privileged"
          ],
          "title": "Effect",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "plan_id": {
          "pattern": "^[a-f0-9]{12}$",
          "title": "Plan Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[a-f0-9]{12}$",
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "approved",
            "denied",
            "expired",
            "consumed"
          ],
          "title": "Status",
          "type": "string"
        },
        "step_id": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Step Id",
          "type": "string"
        },
        "tool_name": {
          "maxLength": 128,
          "minLength": 2,
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "run_id",
        "plan_id",
        "step_id",
        "tool_name",
        "arguments_digest",
        "effect",
        "risk",
        "status",
        "reason",
        "created_at",
        "expires_at"
      ],
      "title": "ApprovalRequest",
      "type": "object"
    },
    "BacktestMetrics": {
      "properties": {
        "final_equity": {
          "title": "Final Equity",
          "type": "number"
        },
        "max_drawdown_pct": {
          "title": "Max Drawdown Pct",
          "type": "number"
        },
        "sharpe_ratio": {
          "title": "Sharpe Ratio",
          "type": "number"
        },
        "total_return_pct": {
          "title": "Total Return Pct",
          "type": "number"
        },
        "trade_count": {
          "title": "Trade Count",
          "type": "integer"
        },
        "win_rate_pct": {
          "title": "Win Rate Pct",
          "type": "number"
        }
      },
      "required": [
        "total_return_pct",
        "max_drawdown_pct",
        "sharpe_ratio",
        "trade_count",
        "win_rate_pct",
        "final_equity"
      ],
      "title": "BacktestMetrics",
      "type": "object"
    },
    "CacheInfo": {
      "description": "Observable provenance for request-local and persistent artifact reuse.",
      "properties": {
        "data_version": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Version"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "fingerprint": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{16}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "reason": {
          "default": "",
          "maxLength": 160,
          "title": "Reason",
          "type": "string"
        },
        "saved_latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Saved Latency Ms",
          "type": "number"
        },
        "saved_tool_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Saved Tool Calls",
          "type": "integer"
        },
        "similarity_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Similarity Score"
        },
        "source_run_id": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Run Id"
        },
        "status": {
          "enum": [
            "miss",
            "exact_hit",
            "semantic_candidate",
            "refresh",
            "bypass"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "CacheInfo",
      "type": "object"
    },
    "DataProfile": {
      "properties": {
        "duplicate_timestamps": {
          "default": 0,
          "title": "Duplicate Timestamps",
          "type": "integer"
        },
        "end_at": {
          "format": "date-time",
          "title": "End At",
          "type": "string"
        },
        "non_positive_prices": {
          "default": 0,
          "title": "Non Positive Prices",
          "type": "integer"
        },
        "row_count": {
          "title": "Row Count",
          "type": "integer"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "start_at": {
          "format": "date-time",
          "title": "Start At",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        },
        "timeframe": {
          "title": "Timeframe",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "source",
        "synthetic",
        "symbol",
        "timeframe",
        "row_count",
        "start_at",
        "end_at"
      ],
      "title": "DataProfile",
      "type": "object"
    },
    "EquityPoint": {
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "equity": {
          "title": "Equity",
          "type": "number"
        }
      },
      "required": [
        "at",
        "equity"
      ],
      "title": "EquityPoint",
      "type": "object"
    },
    "ExecutionPlan": {
      "additionalProperties": false,
      "description": "Validated plan plus an observable deterministic-execution outcome.",
      "properties": {
        "completed_steps": {
          "items": {
            "type": "string"
          },
          "title": "Completed Steps",
          "type": "array"
        },
        "failed_step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failed Step"
        },
        "max_tool_calls": {
          "maximum": 50,
          "minimum": 1,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "paused_step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paused Step"
        },
        "plan_id": {
          "pattern": "^[a-f0-9]{12}$",
          "title": "Plan Id",
          "type": "string"
        },
        "planned_tool_calls": {
          "maximum": 50,
          "minimum": 0,
          "title": "Planned Tool Calls",
          "type": "integer"
        },
        "planner": {
          "title": "Planner",
          "type": "string"
        },
        "rejected_step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejected Step"
        },
        "skill": {
          "title": "Skill",
          "type": "string"
        },
        "skill_version": {
          "title": "Skill Version",
          "type": "string"
        },
        "skipped_steps": {
          "items": {
            "type": "string"
          },
          "title": "Skipped Steps",
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/PlanStep"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "validated": {
          "default": false,
          "title": "Validated",
          "type": "boolean"
        }
      },
      "required": [
        "plan_id",
        "skill",
        "skill_version",
        "planner",
        "steps",
        "max_tool_calls",
        "planned_tool_calls"
      ],
      "title": "ExecutionPlan",
      "type": "object"
    },
    "ExternalResearchResult": {
      "properties": {
        "answer": {
          "title": "Answer",
          "type": "string"
        },
        "freshness": {
          "title": "Freshness",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "query": {
          "title": "Query",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/ResearchSource"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "query",
        "provider",
        "answer",
        "freshness"
      ],
      "title": "ExternalResearchResult",
      "type": "object"
    },
    "ExternalResearchSpec": {
      "additionalProperties": false,
      "properties": {
        "max_results": {
          "default": 5,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Results",
          "type": "integer"
        },
        "query": {
          "maxLength": 500,
          "minLength": 4,
          "title": "Query",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "title": "ExternalResearchSpec",
      "type": "object"
    },
    "IncidentActionItem": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "maxLength": 200,
          "minLength": 4,
          "title": "Action",
          "type": "string"
        },
        "action_id": {
          "maxLength": 6,
          "pattern": "^ACT-[1-9][0-9]?$",
          "title": "Action Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "mitigate",
            "observe",
            "prevent"
          ],
          "title": "Category",
          "type": "string"
        },
        "owner_role": {
          "enum": [
            "on-call",
            "service-owner",
            "platform"
          ],
          "title": "Owner Role",
          "type": "string"
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2"
          ],
          "title": "Priority",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "priority",
        "owner_role",
        "category",
        "action"
      ],
      "title": "IncidentActionItem",
      "type": "object"
    },
    "IncidentInputProfile": {
      "additionalProperties": false,
      "properties": {
        "characters": {
          "maximum": 2000,
          "minimum": 0,
          "title": "Characters",
          "type": "integer"
        },
        "contains_code_fence": {
          "title": "Contains Code Fence",
          "type": "boolean"
        },
        "lines": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Lines",
          "type": "integer"
        },
        "words": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Words",
          "type": "integer"
        }
      },
      "required": [
        "characters",
        "words",
        "lines",
        "contains_code_fence"
      ],
      "title": "IncidentInputProfile",
      "type": "object"
    },
    "IncidentReviewResult": {
      "additionalProperties": false,
      "properties": {
        "action_items": {
          "items": {
            "$ref": "#/$defs/IncidentActionItem"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Action Items",
          "type": "array"
        },
        "findings": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Findings",
          "type": "array"
        },
        "input_profile": {
          "$ref": "#/$defs/IncidentInputProfile"
        },
        "risk_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Risk Score",
          "type": "integer"
        },
        "root_cause_status": {
          "const": "unverified",
          "default": "unverified",
          "title": "Root Cause Status",
          "type": "string"
        },
        "service": {
          "title": "Service",
          "type": "string"
        },
        "severity": {
          "enum": [
            "SEV-1",
            "SEV-2",
            "SEV-3",
            "SEV-4"
          ],
          "title": "Severity",
          "type": "string"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 10,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "service",
        "severity",
        "risk_score",
        "input_profile",
        "findings",
        "action_items",
        "summary"
      ],
      "title": "IncidentReviewResult",
      "type": "object"
    },
    "IncidentSpec": {
      "additionalProperties": false,
      "description": "Bounded facts compiled from an incident-review request.",
      "properties": {
        "affected_requests": {
          "anyOf": [
            {
              "maximum": 1000000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Affected Requests"
        },
        "duration_minutes": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Minutes"
        },
        "error_rate_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Rate Pct"
        },
        "p95_latency_ms": {
          "anyOf": [
            {
              "maximum": 120000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P95 Latency Ms"
        },
        "service": {
          "default": "unknown-service",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Service",
          "type": "string"
        }
      },
      "title": "IncidentSpec",
      "type": "object"
    },
    "IntentDecision": {
      "properties": {
        "action": {
          "default": "allow",
          "enum": [
            "allow",
            "deny"
          ],
          "title": "Action",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Reason"
        },
        "intent": {
          "enum": [
            "backtest_strategy",
            "query_market_data",
            "external_research",
            "incident_review",
            "other"
          ],
          "title": "Intent",
          "type": "string"
        },
        "needs_clarification": {
          "default": false,
          "title": "Needs Clarification",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "router": {
          "default": "governed-llm-router@0.2.0",
          "title": "Router",
          "type": "string"
        },
        "scores": {
          "additionalProperties": {
            "type": "number"
          },
