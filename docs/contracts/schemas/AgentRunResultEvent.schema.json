{
  "$defs": {
    "AgentResultArtifact": {
      "additionalProperties": false,
      "description": "Control-plane projection that deliberately omits the original question.",
      "properties": {
        "cache": {
          "anyOf": [
            {
              "$ref": "#/$defs/CacheInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "interpreter": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Interpreter",
          "type": "string"
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntentDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "skill": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Skill",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "rejected",
            "pending_approval"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "maxLength": 4000,
          "title": "Summary",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "status",
        "skill",
        "interpreter",
        "summary"
      ],
      "title": "AgentResultArtifact",
      "type": "object"
    },
    "CacheInfo": {
      "description": "Observable provenance for request-local and persistent artifact reuse.",
      "properties": {
        "data_version": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Version"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "fingerprint": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{16}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "reason": {
          "default": "",
          "maxLength": 160,
          "title": "Reason",
          "type": "string"
        },
        "saved_latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Saved Latency Ms",
          "type": "number"
        },
        "saved_tool_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Saved Tool Calls",
          "type": "integer"
        },
        "similarity_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Similarity Score"
        },
        "source_run_id": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Run Id"
        },
        "status": {
          "enum": [
            "miss",
            "exact_hit",
            "semantic_candidate",
            "refresh",
            "bypass"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "CacheInfo",
      "type": "object"
    },
    "ExecutionPlan": {
      "additionalProperties": false,
      "description": "Validated plan plus an observable deterministic-execution outcome.",
      "properties": {
        "completed_steps": {
          "items": {
            "type": "string"
          },
          "title": "Completed Steps",
          "type": "array"
        },
        "failed_step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failed Step"
        },
        "max_tool_calls": {
          "maximum": 50,
          "minimum": 1,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "paused_step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paused Step"
        },
        "plan_id": {
          "pattern": "^[a-f0-9]{12}$",
          "title": "Plan Id",
          "type": "string"
        },
        "planned_tool_calls": {
          "maximum": 50,
          "minimum": 0,
          "title": "Planned Tool Calls",
          "type": "integer"
        },
        "planner": {
          "title": "Planner",
          "type": "string"
        },
        "rejected_step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejected Step"
        },
        "skill": {
          "title": "Skill",
          "type": "string"
        },
        "skill_version": {
          "title": "Skill Version",
          "type": "string"
        },
        "skipped_steps": {
          "items": {
            "type": "string"
          },
          "title": "Skipped Steps",
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/PlanStep"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "validated": {
          "default": false,
          "title": "Validated",
          "type": "boolean"
        }
      },
      "required": [
        "plan_id",
        "skill",
        "skill_version",
        "planner",
        "steps",
        "max_tool_calls",
        "planned_tool_calls"
      ],
      "title": "ExecutionPlan",
      "type": "object"
    },
    "IntentDecision": {
      "properties": {
        "action": {
          "default": "allow",
          "enum": [
            "allow",
            "deny"
          ],
          "title": "Action",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Reason"
        },
        "intent": {
          "enum": [
            "backtest_strategy",
            "query_market_data",
            "external_research",
            "incident_review",
            "other"
          ],
          "title": "Intent",
          "type": "string"
        },
        "needs_clarification": {
          "default": false,
          "title": "Needs Clarification",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "router": {
          "default": "governed-llm-router@0.2.0",
          "title": "Router",
          "type": "string"
        },
        "scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Scores",
          "type": "object"
        },
        "skill": {
          "enum": [
            "backtest-strategy",
            "query-market-data",
            "external-research",
            "incident-review",
            "general-response"
          ],
          "title": "Skill",
          "type": "string"
        },
        "threat_signals": {
          "items": {
            "$ref": "#/$defs/ThreatSignal"
          },
          "title": "Threat Signals",
          "type": "array"
        }
      },
      "required": [
        "intent",
        "skill",
        "confidence",
        "reason"
      ],
      "title": "IntentDecision",
      "type": "object"
    },
    "MessageMetadata": {
      "additionalProperties": false,
      "description": "Metadata carried in Kafka headers or a message envelope.\n\nTopic names and reply destinations are deployment configuration, never caller\ninput. This prevents an untrusted request from turning into an SSRF-like broker\nrouting primitive.",
      "properties": {
        "attempt": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "causation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 8,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "correlation_id": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Correlation Id",
          "type": "string"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "producer": {
          "enum": [
            "control-plane",
            "agent-service",
            "backtest-service"
          ],
          "title": "Producer",
          "type": "string"
        },
        "schema_version": {
          "const": "message-metadata-v1",
          "default": "message-metadata-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "traceparent": {
          "anyOf": [
            {
              "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceparent"
        },
        "tracestate": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tracestate"
        }
      },
      "required": [
        "message_id",
        "correlation_id",
        "producer",
        "occurred_at"
      ],
      "title": "MessageMetadata",
      "type": "object"
    },
    "PlanStep": {
      "additionalProperties": false,
      "description": "One bounded executor step derived from a versioned Skill manifest.",
      "properties": {
        "depends_on": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Depends On",
          "type": "array"
        },
        "kind": {
          "enum": [
            "control",
            "tool"
          ],
          "title": "Kind",
          "type": "string"
        },
        "order": {
          "maximum": 32,
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "step_id": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Step Id",
          "type": "string"
        },
        "tool_name": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Name"
        }
      },
      "required": [
        "step_id",
        "order",
        "kind"
      ],
      "title": "PlanStep",
      "type": "object"
    },
    "ProblemDetails": {
      "additionalProperties": false,
      "description": "Stable RFC 7807-style error body; internal exception text is excluded.",
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 8,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "status": {
          "maximum": 599,
          "minimum": 400,
          "title": "Status",
          "type": "integer"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "trace_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "type": {
          "default": "about:blank",
          "maxLength": 256,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "title",
        "status",
        "code",
        "detail"
      ],
      "title": "ProblemDetails",
      "type": "object"
    },
    "ThreatSignal": {
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "category",
        "confidence",
        "evidence"
      ],
      "title": "ThreatSignal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentResultArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProblemDetails"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "event_type": {
      "enum": [
        "agent.run.completed.v1",
        "agent.run.rejected.v1",
        "agent.run.approval-required.v1",
        "agent.run.failed.v1"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "job_id": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Job Id",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/MessageMetadata"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "agent-run-result-v1",
      "default": "agent-run-result-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "event_type",
    "metadata",
    "job_id",
    "run_id"
  ],
  "title": "AgentRunResultEvent",
  "type": "object"
}
