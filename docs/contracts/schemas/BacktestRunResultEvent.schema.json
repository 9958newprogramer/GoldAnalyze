{
  "$defs": {
    "BacktestExecuteResponse": {
      "additionalProperties": false,
      "properties": {
        "data_profile": {
          "$ref": "#/$defs/DataProfile"
        },
        "data_version": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Data Version",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "engine_version": {
          "const": "sma-crossover-v1",
          "default": "sma-crossover-v1",
          "title": "Engine Version",
          "type": "string"
        },
        "equity_curve": {
          "items": {
            "$ref": "#/$defs/EquityPoint"
          },
          "maxItems": 321,
          "title": "Equity Curve",
          "type": "array"
        },
        "job_id": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Job Id",
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/BacktestMetrics"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Request Id",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "backtest-result-v1",
          "default": "backtest-result-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "const": "completed",
          "default": "completed",
          "title": "Status",
          "type": "string"
        },
        "strategy": {
          "$ref": "#/$defs/StrategySpec"
        },
        "trades": {
          "items": {
            "$ref": "#/$defs/Trade"
          },
          "maxItems": 10000,
          "title": "Trades",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "job_id",
        "run_id",
        "data_version",
        "strategy",
        "data_profile",
        "metrics",
        "result_digest",
        "duration_ms"
      ],
      "title": "BacktestExecuteResponse",
      "type": "object"
    },
    "BacktestMetrics": {
      "properties": {
        "final_equity": {
          "title": "Final Equity",
          "type": "number"
        },
        "max_drawdown_pct": {
          "title": "Max Drawdown Pct",
          "type": "number"
        },
        "sharpe_ratio": {
          "title": "Sharpe Ratio",
          "type": "number"
        },
        "total_return_pct": {
          "title": "Total Return Pct",
          "type": "number"
        },
        "trade_count": {
          "title": "Trade Count",
          "type": "integer"
        },
        "win_rate_pct": {
          "title": "Win Rate Pct",
          "type": "number"
        }
      },
      "required": [
        "total_return_pct",
        "max_drawdown_pct",
        "sharpe_ratio",
        "trade_count",
        "win_rate_pct",
        "final_equity"
      ],
      "title": "BacktestMetrics",
      "type": "object"
    },
    "DataProfile": {
      "properties": {
        "duplicate_timestamps": {
          "default": 0,
          "title": "Duplicate Timestamps",
          "type": "integer"
        },
        "end_at": {
          "format": "date-time",
          "title": "End At",
          "type": "string"
        },
        "non_positive_prices": {
          "default": 0,
          "title": "Non Positive Prices",
          "type": "integer"
        },
        "row_count": {
          "title": "Row Count",
          "type": "integer"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "start_at": {
          "format": "date-time",
          "title": "Start At",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        },
        "timeframe": {
          "title": "Timeframe",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "source",
        "synthetic",
        "symbol",
        "timeframe",
        "row_count",
        "start_at",
        "end_at"
      ],
      "title": "DataProfile",
      "type": "object"
    },
    "EquityPoint": {
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "equity": {
          "title": "Equity",
          "type": "number"
        }
      },
      "required": [
        "at",
        "equity"
      ],
      "title": "EquityPoint",
      "type": "object"
    },
    "MessageMetadata": {
      "additionalProperties": false,
      "description": "Metadata carried in Kafka headers or a message envelope.\n\nTopic names and reply destinations are deployment configuration, never caller\ninput. This prevents an untrusted request from turning into an SSRF-like broker\nrouting primitive.",
      "properties": {
        "attempt": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "causation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 8,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "correlation_id": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Correlation Id",
          "type": "string"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "producer": {
          "enum": [
            "control-plane",
            "agent-service",
            "backtest-service"
          ],
          "title": "Producer",
          "type": "string"
        },
        "schema_version": {
          "const": "message-metadata-v1",
          "default": "message-metadata-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "traceparent": {
          "anyOf": [
            {
              "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceparent"
        },
        "tracestate": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tracestate"
        }
      },
      "required": [
        "message_id",
        "correlation_id",
        "producer",
        "occurred_at"
      ],
      "title": "MessageMetadata",
      "type": "object"
    },
    "ProblemDetails": {
      "additionalProperties": false,
      "description": "Stable RFC 7807-style error body; internal exception text is excluded.",
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 8,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "status": {
          "maximum": 599,
          "minimum": 400,
          "title": "Status",
          "type": "integer"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "trace_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "type": {
          "default": "about:blank",
          "maxLength": 256,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "title",
        "status",
        "code",
        "detail"
      ],
      "title": "ProblemDetails",
      "type": "object"
    },
    "StrategySpec": {
      "additionalProperties": false,
      "properties": {
        "end_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Date"
        },
        "execution": {
          "const": "next_bar_open",
          "default": "next_bar_open",
          "title": "Execution",
          "type": "string"
        },
        "fast_window": {
          "default": 20,
          "maximum": 200,
          "minimum": 2,
          "title": "Fast Window",
          "type": "integer"
        },
        "fee_bps": {
          "default": 2.0,
          "maximum": 100,
          "minimum": 0,
          "title": "Fee Bps",
          "type": "number"
        },
        "initial_cash": {
          "default": 100000.0,
          "exclusiveMinimum": 0,
          "maximum": 100000000,
          "title": "Initial Cash",
          "type": "number"
        },
        "long_only": {
          "const": true,
          "default": true,
          "title": "Long Only",
          "type": "boolean"
        },
        "slippage_bps": {
          "default": 3.0,
          "maximum": 100,
          "minimum": 0,
          "title": "Slippage Bps",
          "type": "number"
        },
        "slow_window": {
          "default": 60,
          "maximum": 400,
          "minimum": 3,
          "title": "Slow Window",
          "type": "integer"
        },
        "start_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Date"
        },
        "strategy_type": {
          "const": "sma_crossover",
          "default": "sma_crossover",
          "title": "Strategy Type",
          "type": "string"
        },
        "symbol": {
          "default": "XAUUSD",
          "maxLength": 32,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "timeframe": {
          "default": "1d",
          "enum": [
            "1d",
            "1h"
          ],
          "title": "Timeframe",
          "type": "string"
        }
      },
      "title": "StrategySpec",
      "type": "object"
    },
    "Trade": {
      "properties": {
        "entry_at": {
          "format": "date-time",
          "title": "Entry At",
          "type": "string"
        },
        "entry_price": {
          "title": "Entry Price",
          "type": "number"
        },
        "exit_at": {
          "format": "date-time",
          "title": "Exit At",
          "type": "string"
        },
        "exit_price": {
          "title": "Exit Price",
          "type": "number"
        },
        "exit_reason": {
          "title": "Exit Reason",
          "type": "string"
        },
        "pnl": {
          "title": "Pnl",
          "type": "number"
        },
        "quantity": {
          "title": "Quantity",
          "type": "number"
        },
        "return_pct": {
          "title": "Return Pct",
          "type": "number"
        }
      },
      "required": [
        "entry_at",
        "exit_at",
        "entry_price",
        "exit_price",
        "quantity",
        "pnl",
        "return_pct",
        "exit_reason"
      ],
      "title": "Trade",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProblemDetails"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "event_type": {
      "enum": [
        "backtest.run.completed.v1",
        "backtest.run.failed.v1"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "job_id": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Job Id",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/MessageMetadata"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/BacktestExecuteResponse"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "backtest-run-result-v1",
      "default": "backtest-run-result-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "event_type",
    "metadata",
    "job_id",
    "run_id"
  ],
  "title": "BacktestRunResultEvent",
  "type": "object"
}
