{
  "$defs": {
    "BacktestExecuteRequest": {
      "additionalProperties": false,
      "description": "Bounded deterministic calculation request from the control plane/Agent.",
      "properties": {
        "deadline_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline At"
        },
        "expected_data_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Data Version"
        },
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 16,
          "title": "Idempotency Key",
          "type": "string"
        },
        "job_id": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Job Id",
          "type": "string"
        },
        "max_bars": {
          "default": 250000,
          "maximum": 500000,
          "minimum": 100,
          "title": "Max Bars",
          "type": "integer"
        },
        "max_trades": {
          "default": 5000,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Trades",
          "type": "integer"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Request Id",
          "type": "string"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "backtest-request-v1",
          "default": "backtest-request-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "strategy": {
          "$ref": "#/$defs/StrategySpec"
        }
      },
      "required": [
        "request_id",
        "job_id",
        "run_id",
        "idempotency_key",
        "strategy"
      ],
      "title": "BacktestExecuteRequest",
      "type": "object"
    },
    "MessageMetadata": {
      "additionalProperties": false,
      "description": "Metadata carried in Kafka headers or a message envelope.\n\nTopic names and reply destinations are deployment configuration, never caller\ninput. This prevents an untrusted request from turning into an SSRF-like broker\nrouting primitive.",
      "properties": {
        "attempt": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "causation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 8,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "correlation_id": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Correlation Id",
          "type": "string"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "producer": {
          "enum": [
            "control-plane",
            "agent-service",
            "backtest-service"
          ],
          "title": "Producer",
          "type": "string"
        },
        "schema_version": {
          "const": "message-metadata-v1",
          "default": "message-metadata-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "traceparent": {
          "anyOf": [
            {
              "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceparent"
        },
        "tracestate": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tracestate"
        }
      },
      "required": [
        "message_id",
        "correlation_id",
        "producer",
        "occurred_at"
      ],
      "title": "MessageMetadata",
      "type": "object"
    },
    "StrategySpec": {
      "additionalProperties": false,
      "properties": {
        "end_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Date"
        },
        "execution": {
          "const": "next_bar_open",
          "default": "next_bar_open",
          "title": "Execution",
          "type": "string"
        },
        "fast_window": {
          "default": 20,
          "maximum": 200,
          "minimum": 2,
          "title": "Fast Window",
          "type": "integer"
        },
        "fee_bps": {
          "default": 2.0,
          "maximum": 100,
          "minimum": 0,
          "title": "Fee Bps",
          "type": "number"
        },
        "initial_cash": {
          "default": 100000.0,
          "exclusiveMinimum": 0,
          "maximum": 100000000,
          "title": "Initial Cash",
          "type": "number"
        },
        "long_only": {
          "const": true,
          "default": true,
          "title": "Long Only",
          "type": "boolean"
        },
        "slippage_bps": {
          "default": 3.0,
          "maximum": 100,
          "minimum": 0,
          "title": "Slippage Bps",
          "type": "number"
        },
        "slow_window": {
          "default": 60,
          "maximum": 400,
          "minimum": 3,
          "title": "Slow Window",
          "type": "integer"
        },
        "start_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Date"
        },
        "strategy_type": {
          "const": "sma_crossover",
          "default": "sma_crossover",
          "title": "Strategy Type",
          "type": "string"
        },
        "symbol": {
          "default": "XAUUSD",
          "maxLength": 32,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "timeframe": {
          "default": "1d",
          "enum": [
            "1d",
            "1h"
          ],
          "title": "Timeframe",
          "type": "string"
        }
      },
      "title": "StrategySpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_type": {
      "const": "backtest.run.requested.v1",
      "default": "backtest.run.requested.v1",
      "title": "Event Type",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/MessageMetadata"
    },
    "payload": {
      "$ref": "#/$defs/BacktestExecuteRequest"
    },
    "schema_version": {
      "const": "backtest-run-requested-v1",
      "default": "backtest-run-requested-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "metadata",
    "payload"
  ],
  "title": "BacktestRunRequestedCommand",
  "type": "object"
}
