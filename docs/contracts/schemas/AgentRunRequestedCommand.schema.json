{
  "$defs": {
    "MessageMetadata": {
      "additionalProperties": false,
      "description": "Metadata carried in Kafka headers or a message envelope.\n\nTopic names and reply destinations are deployment configuration, never caller\ninput. This prevents an untrusted request from turning into an SSRF-like broker\nrouting primitive.",
      "properties": {
        "attempt": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "causation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 8,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "correlation_id": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Correlation Id",
          "type": "string"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "producer": {
          "enum": [
            "control-plane",
            "agent-service",
            "backtest-service"
          ],
          "title": "Producer",
          "type": "string"
        },
        "schema_version": {
          "const": "message-metadata-v1",
          "default": "message-metadata-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "traceparent": {
          "anyOf": [
            {
              "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceparent"
        },
        "tracestate": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tracestate"
        }
      },
      "required": [
        "message_id",
        "correlation_id",
        "producer",
        "occurred_at"
      ],
      "title": "MessageMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cache_policy": {
      "default": "use",
      "enum": [
        "use",
        "refresh",
        "bypass"
      ],
      "title": "Cache Policy",
      "type": "string"
    },
    "event_type": {
      "const": "agent.run.requested.v1",
      "default": "agent.run.requested.v1",
      "title": "Event Type",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 16,
      "title": "Idempotency Key",
      "type": "string"
    },
    "job_id": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Job Id",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/MessageMetadata"
    },
    "question": {
      "maxLength": 1000,
      "minLength": 4,
      "title": "Question",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "agent-run-requested-v1",
      "default": "agent-run-requested-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "metadata",
    "job_id",
    "run_id",
    "idempotency_key",
    "question"
  ],
  "title": "AgentRunRequestedCommand",
  "type": "object"
}
