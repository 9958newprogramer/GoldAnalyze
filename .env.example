# LLM intent router. Without these values only the deterministic fallback is available.
APP_HOST=127.0.0.1
APP_PORT=8010
EVAL_DATASET_PATH=evals/golden.v4.jsonl
ROUTER_LLM_API_KEY=
ROUTER_LLM_BASE_URL=https://api.openai.com/v1
ROUTER_LLM_MODEL=gpt-5-mini
ROUTER_LLM_TIMEOUT_SECONDS=8
# Set true for providers/models that expose an enable_thinking extension, e.g. Qwen on SiliconFlow.
ROUTER_LLM_DISABLE_THINKING=false

# v0.4 persistent Artifact Cache. Backtests invalidate on market-data version changes;
# time-sensitive market and research artifacts also expire by TTL.
ARTIFACT_CACHE_ENABLED=true
ARTIFACT_CACHE_MAX_ENTRIES=200
MARKET_CACHE_TTL_SECONDS=300
RESEARCH_CACHE_TTL_SECONDS=900
CACHE_SEMANTIC_THRESHOLD=0.82

# Optional: use a separate OpenAI-compatible model to compile StrategySpec.
# Without these values the selected backtest Skill uses its deterministic compiler.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# Optional: connect a read-only SQLite market database.
# When omitted, the app uses deterministic synthetic gold data so the demo runs immediately.
MARKET_DB_PATH=
MARKET_TABLE=gold_bars
MARKET_TIME_COLUMN=timestamp
MARKET_SYMBOL_COLUMN=symbol
MARKET_TIMEFRAME_COLUMN=timeframe
MARKET_OPEN_COLUMN=open
MARKET_HIGH_COLUMN=high
MARKET_LOW_COLUMN=low
MARKET_CLOSE_COLUMN=close
MARKET_VOLUME_COLUMN=volume
MARKET_SYMBOL=XAUUSD
