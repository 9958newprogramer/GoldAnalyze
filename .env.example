# LLM intent router. Without these values only the deterministic fallback is available.
APP_HOST=127.0.0.1
APP_PORT=8010
AGENT_SERVICE_HOST=127.0.0.1
AGENT_SERVICE_PORT=8011
BACKTEST_SERVICE_HOST=127.0.0.1
BACKTEST_SERVICE_PORT=8020
BACKTEST_SERVICE_URL=http://127.0.0.1:8020
BACKTEST_SERVICE_TIMEOUT_SECONDS=30
AGENT_BACKTEST_ADAPTER=local
BACKTEST_ALLOW_INSECURE_HTTP=false
# Set a random value with at least 32 characters before binding beyond loopback.
INTERNAL_SERVICE_TOKEN=
# Optional for wheel/container deployments where skills/ and evals/ live outside site-packages.
APP_PROJECT_ROOT=
EVAL_DATASET_PATH=evals/golden.v7.jsonl
ROUTER_LLM_API_KEY=
ROUTER_LLM_BASE_URL=https://api.openai.com/v1
ROUTER_LLM_MODEL=gpt-5-mini
ROUTER_LLM_TIMEOUT_SECONDS=8
# Set true for providers/models that expose an enable_thinking extension, e.g. Qwen on SiliconFlow.
ROUTER_LLM_DISABLE_THINKING=false

# v0.4 persistent Artifact Cache. Backtests invalidate on market-data version changes;
# time-sensitive market and research artifacts also expire by TTL.
ARTIFACT_CACHE_ENABLED=true
ARTIFACT_CACHE_MAX_ENTRIES=200
MARKET_CACHE_TTL_SECONDS=300
RESEARCH_CACHE_TTL_SECONDS=900
CACHE_SEMANTIC_THRESHOLD=0.82

# v0.7 one-time human approval bearer token lifetime (30-3600 seconds).
APPROVAL_TTL_SECONDS=300

# Async Agent runtime. Redis carries opaque Job IDs only; SQLite stores state/checkpoints/events.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PROTOCOL=2
JOB_STREAM_NAME=aurumlab:jobs:v1
JOB_CONSUMER_GROUP=aurumlab-workers-v1
JOB_LEASE_SECONDS=60
JOB_STAGE_TIMEOUT_SECONDS=30
JOB_RECLAIM_IDLE_MS=60000
SSE_POLL_INTERVAL_SECONDS=0.25
SSE_HEARTBEAT_SECONDS=10

# OpenTelemetry: memory gives a bounded local evidence API; use otlp for a Collector.
OTEL_SERVICE_NAME=aurumlab
OTEL_EXPORTER=memory
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SAMPLE_RATIO=1.0
OTEL_MEMORY_MAX_SPANS=500
OTEL_METRIC_EXPORT_INTERVAL_SECONDS=30

# Optional: use a separate OpenAI-compatible model to compile StrategySpec.
# Without these values the selected backtest Skill uses its deterministic compiler.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# Optional: connect a read-only SQLite market database.
# When omitted, the app uses deterministic synthetic gold data so the demo runs immediately.
MARKET_DB_PATH=
MARKET_TABLE=gold_bars
MARKET_TIME_COLUMN=timestamp
MARKET_SYMBOL_COLUMN=symbol
MARKET_TIMEFRAME_COLUMN=timeframe
MARKET_OPEN_COLUMN=open
MARKET_HIGH_COLUMN=high
MARKET_LOW_COLUMN=low
MARKET_CLOSE_COLUMN=close
MARKET_VOLUME_COLUMN=volume
MARKET_SYMBOL=XAUUSD
